# ========================================================
# AI LEAD FINDER — ENVIRONMENT CONFIGURATION
# ========================================================

# Server & Environment
PORT=5000
NODE_ENV=production
JWT_SECRET=replace-with-a-random-32-char-secure-secret-key-2026

# PostgreSQL Database (Required for Docker/VPS deployment)
DATABASE_URL=postgresql://postgres:postgres_secure_pass_2026@localhost:5432/ai_lead_finder?schema=public

# Redis BullMQ Background Queue
REDIS_URL=redis://localhost:6379

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.2

# Multi-Source Business Discovery Providers
TAVILY_API_KEY=
SERPAPI_API_KEY=
BING_API_KEY=
GOOGLE_PLACES_API_KEY=

# Email Verification Provider (e.g. Hunter.io)
EMAIL_VERIFIER_PROVIDER=hunter
EMAIL_VERIFIER_API_KEY=

# Website Extraction Engine Parameters
EXTRACTION_TIMEOUT_MS=12000
EXTRACTION_CONCURRENCY=5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36 AILeadFinderBot/1.0
